{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-explicit-any": "off",
    "no-this-alias": "off",
    "require-yield": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/managed/**",
    "backend/packages/midnight/frontend-libs/**"
  ]
}

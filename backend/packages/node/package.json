{
  "name": "@dust2dust-backend/node",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./main.ts",
  "scripts": {
    "check": "bun x tsc --noEmit -p ../../../tsconfig.check.json",
    "check:dev": "bun x tsc --noEmit -p ../../../tsconfig.check.json",
    "check:testnet": "bun x tsc --noEmit -p ../../../tsconfig.check.json",
    "check:mainnet": "bun x tsc --noEmit -p ../../../tsconfig.check.json",
    "node:start:dev": "bun --inspect --env-file=.env.dev main.dev.ts",
    "node:start:testnet": "bun --inspect --env-file=.env.testnet main.testnet.ts",
    "node:start:mainnet": "bun --inspect --env-file=.env.mainnet main.mainnet.ts",
    "dev": "EFFECTSTREAM_ENV=dev bun x --bun orchestrator start ./start-script.dev.ts",
    "testnet": "EFFECTSTREAM_ENV=testnet bun x --bun orchestrator start ./start-script.testnet.ts",
    "mainnet": "EFFECTSTREAM_ENV=mainnet bun x --bun orchestrator start ./start-script.mainnet.ts"
  },
  "dependencies": {
    "@effectstream/concise": "0.100.28",
    "@effectstream/config": "0.100.28",
    "@effectstream/coroutine": "0.100.28",
    "@effectstream/midnight-contracts": "0.100.28",
    "@effectstream/orchestrator": "0.100.28",
    "@effectstream/runtime": "0.100.28",
    "@effectstream/sm": "0.100.28",
    "@effectstream/utils": "0.100.28",
    "@sinclair/typebox": "0.34.41",
    "@scure/base": "^2.0.0",
    "viem": "2.37.3",
    "effection": "^3.5.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/midnight-js-types": "4.0.4",
    "@midnight-ntwrk/midnight-js-utils": "4.0.4",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0",
    "@midnight-ntwrk/zswap": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
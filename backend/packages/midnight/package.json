{
  "name": "@dust2dust-backend/midnight-contracts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./game2": "./contract-game2/src/index.ts"
  },
  "scripts": {
    "midnight-node:start": "MIDNIGHT_STORAGE_PASSWORD=YourPasswordMy1! CFG_PRESET=dev npm-midnight-node --dev --rpc-port 9944 --state-pruning archive --blocks-pruning archive --public-addr /ip4/127.0.0.1 --unsafe-rpc-external",
    "midnight-node:wait": "wait-on tcp:9944",
    "midnight-indexer:start": "RUST_BACKTRACE=1 LEDGER_NETWORK_ID=\"Undeployed\" SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" APP__INFRA__SECRET=$(openssl rand -hex 32 | tr 'a-f' 'A-F') FEATURES_WALLET_ENABLED=\"true\" APP__INFRA__NODE__URL=\"ws://localhost:9944\" npm-midnight-indexer --binary --clean",
    "midnight-indexer:wait": "wait-on tcp:8088",
    "midnight-proof-server:start": "RUST_BACKTRACE=full SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" npm-midnight-proof-server",
    "midnight-proof-server:wait": "wait-on tcp:6300",
    "midnight-contract:clean": "rm -rf midnight-level-db",
    "compact": "cd contract-game2 && bun run compact",
    "midnight-contract:deploy": "bun run contract-game2:deploy",
    "contract-game2:deploy": "bun run contract-game2-deploy.ts",
    "contract-game2:deploy:dev": "MIDNIGHT_NETWORK_ID=undeployed bun run contract-game2-deploy.ts",
    "contract-game2:deploy:testnet": "MIDNIGHT_NETWORK_ID=preprod bun run contract-game2-deploy.ts",
    "contract-game2:deploy:mainnet": "MIDNIGHT_NETWORK_ID=mainnet bun run contract-game2-deploy.ts",
    "contract-game2:admin": "bun run contract-game2-admin.ts",
    "contract-game2:admin:dev": "MIDNIGHT_NETWORK_ID=undeployed bun run contract-game2-admin.ts",
    "contract-game2:admin:testnet": "MIDNIGHT_NETWORK_ID=preprod bun run contract-game2-admin.ts",
    "contract-game2:admin:mainnet": "MIDNIGHT_NETWORK_ID=mainnet bun run contract-game2-admin.ts",
    "contract-game2:test": "bun run contract-game2-test.ts",
    "contract-game2:test:dev": "MIDNIGHT_NETWORK_ID=undeployed bun run contract-game2-test.ts",
    "contract-game2:patch-frontend": "bun run contract-game2-deploy.ts patch-frontend-env",
    "contract-game2:patch-frontend:dev": "MIDNIGHT_NETWORK_ID=undeployed bun run contract-game2-deploy.ts patch-frontend-env",
    "contract-game2:patch-frontend:testnet": "MIDNIGHT_NETWORK_ID=preprod bun run contract-game2-deploy.ts patch-frontend-env",
    "contract-game2:patch-frontend:mainnet": "MIDNIGHT_NETWORK_ID=mainnet bun run contract-game2-deploy.ts patch-frontend-env"
  },
  "dependencies": {
    "@effectstream/midnight-contracts": "0.101.1",
    "@effectstream/npm-midnight-node": "0.101.1",
    "@effectstream/npm-midnight-indexer": "0.101.1",
    "@effectstream/npm-midnight-proof-server": "0.101.1",
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-types": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-utils": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "rxjs": "^7.8.2",
    "ws": "^8.18.0",
    "commander": "^12.0.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.3",
    "wait-on": "^9.0.4",
    "game2-contract": "workspace:*",
    "game2-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}